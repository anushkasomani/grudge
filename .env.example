# ---- LLM providers (at least one; without either, use --offline) ----
# The vendor agent defaults to Groq, the buyer agent to Anthropic.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# GRUDGE_GROQ_MODEL=llama-3.3-70b-versatile
# GRUDGE_ANTHROPIC_MODEL=claude-sonnet-5
# GRUDGE_BUYER_PROVIDER=anthropic
# GRUDGE_VENDOR_PROVIDER=groq

# ---- Base Sepolia settlement (real USDC transfer) ----
# Fund this wallet with testnet USDC at https://faucet.circle.com (Base Sepolia)
BASE_PRIVATE_KEY=
VENDOR_WALLET_ADDRESS=
# BASE_RPC_URL=https://sepolia.base.org
# Annual contract value is scaled down so a faucet balance covers many demos.
# GRUDGE_USDC_SCALE=0.0001

# ---- Virtuals ACP (optional; falls back to direct USDC transfer) ----
ACP_AGENT_PRIVATE_KEY=
ACP_ENTITY_ID=
ACP_PROVIDER_ADDRESS=

# ---- Memory ----
# GRUDGE_DB=memory_store/grudge.db
